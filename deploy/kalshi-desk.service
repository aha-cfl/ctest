[Unit]
Description=Kalshi KXBTC15M paper desk (one process: record, decide, paper-fill, settle, dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
WorkingDirectory=/opt/kalshi
# Paper only: no real orders. Dashboard on 127.0.0.1:8080 (no login): ssh -L 8080:localhost:8080 you@server
ExecStart=/opt/kalshi/.venv/bin/python -m kalshi --data /var/lib/kalshi run --serve 8080
Restart=always
RestartSec=1
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kalshi

[Install]
WantedBy=multi-user.target
